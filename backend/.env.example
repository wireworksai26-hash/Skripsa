# Kredensial backend SkripsiAI — jangan di-commit (sudah masuk .gitignore).
# Semua variabel berawalan SKRIPSI_ (lihat app/core/config.py).

# --- NVIDIA NIM (LLM) ---------------------------------------------------
# Kosong = backend memakai fallback lokal tanpa LLM.
# Kunci dibuat di https://build.nvidia.com (diawali "nvapi-").
SKRIPSI_NIM_API_KEY=
SKRIPSI_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
SKRIPSI_NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Cadangan NIM berurutan (dipakai bila model utama gagal atau mutunya buruk):
SKRIPSI_NIM_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b

# --- Groq (cepat; dipakai untuk judul & tugas ringan) --------------------
# Kunci di https://console.groq.com/keys (diawali "gsk_").
SKRIPSI_GROQ_API_KEY=
SKRIPSI_GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (cadangan cepat) ---------------------------------------
# Kunci di https://aistudio.google.com/apikey
SKRIPSI_GEMINI_API_KEY=
SKRIPSI_GEMINI_MODEL=gemini-2.5-flash

# --- Orkestrasi: urutan penyedia per jenis tugas ---------------------------
# Penyedia tanpa kunci dilewati; bila satu gagal (429/timeout) lanjut ke berikutnya.
SKRIPSI_LLM_FAST_ORDER=groq,gemini,nim
SKRIPSI_LLM_HEAVY_ORDER=nim,gemini,groq

# --- Keamanan ------------------------------------------------------------
# Penanda token login (JWT). WAJIB diisi acak minimal 32 karakter.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
SKRIPSI_SECRET_KEY=
# production = dokumentasi API (/docs, /openapi.json) dimatikan.
SKRIPSI_ENVIRONMENT=development

# --- Email untuk Crossref/OpenAlex (mailto) dan Unpaywall ----------------
# WAJIB email asli agar Unpaywall aktif (mengisi tautan PDF terbuka lewat DOI).
# Email ini dikirim ke API publik tersebut; pilih alamat yang Anda mau.
SKRIPSI_POLITE_EMAIL=

# --- OpenAlex (sejak 13 Feb 2026 wajib kunci; gratis $1/hari per akun) ----
# Daftar di https://openalex.org lalu salin kunci dari https://openalex.org/settings/api
SKRIPSI_OPENALEX_API_KEY=

# --- CORE (agregator repositori akses terbuka; kunci opsional) ------------
# Tanpa kunci kuotanya kecil. Kunci gratis: https://core.ac.uk/services/api
SKRIPSI_CORE_API_KEY=

# --- Semantic Scholar (opsional, menghindari batas kuota bersama) --------
# Minta kunci gratis di https://www.semanticscholar.org/product/api
SKRIPSI_SEMANTIC_SCHOLAR_API_KEY=

# --- Opsional ------------------------------------------------------------
# Format JSON list. Default: localhost:3000.
# SKRIPSI_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Default: SQLite backend/skripsi.db. Contoh Postgres:
# SKRIPSI_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/skripsi

# --- Push notification (OneSignal) ----------------------------------------
# App ID dan REST API Key ada di OneSignal > Settings > Keys & IDs. Kosongkan untuk menonaktifkan push.
# Frontend memakai NEXT_PUBLIC_ONESIGNAL_APP_ID (nilai App ID yang sama) di .env.local.
SKRIPSI_ONESIGNAL_APP_ID=
SKRIPSI_ONESIGNAL_API_KEY=
# Alamat aplikasi yang dibuka saat notifikasi diketuk (produksi: domain HTTPS Anda).
SKRIPSI_APP_URL=http://localhost:3000
